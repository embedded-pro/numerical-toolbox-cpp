{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "defaults",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "On",
        "CMAKE_COMPILE_WARNING_AS_ERROR": "On"
      }
    },
    {
      "name": "host",
      "displayName": "Configuration for Host Tooling and Tests",
      "inherits": "defaults",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo;MinSizeRel",
        "NUMERICAL_TOOLBOX_BUILD_TESTS": true,
        "NUMERICAL_TOOLBOX_BUILD_SIMULATOR": true
      },
      "generator": "Ninja Multi-Config"
    },
    {
      "name": "host-single-Debug",
      "displayName": "Configuration for Host Tooling and Tests, Single Config Generator, Debug",
      "inherits": "defaults",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "NUMERICAL_TOOLBOX_BUILD_TESTS": true
      }
    },
    {
      "name": "coverage",
      "displayName": "Configuration for Code Coverage",
      "inherits": "host",
      "cacheVariables": {
        "EMIL_ENABLE_COVERAGE": "On",
        "NUMERICAL_TOOLBOX_ENABLE_OPTIMIZATIONS": "Off",
        "NUMERICAL_TOOLBOX_BUILD_SIMULATOR": true
      },
      "generator": "Ninja"
    },
    {
      "name": "integration",
      "displayName": "Configuration for Cucumber Integration Tests",
      "inherits": "host",
      "cacheVariables": {
        "NUMERICAL_TOOLBOX_BUILD_INTEGRATION_TESTS": true,
        "NUMERICAL_TOOLBOX_BUILD_TESTS": false,
        "NUMERICAL_TOOLBOX_BUILD_SIMULATOR": false
      }
    },
    {
      "name": "qemu-cortex-m4",
      "displayName": "QEMU Cortex-M4 Tests",
      "inherits": "defaults",
      "toolchainFile": "${sourceDir}/build/${presetName}/_deps/emil-src/cmake/toolchain-arm-gcc-m4-fpv4-sp-d16.cmake",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "RelWithDebInfo",
        "NUMERICAL_TOOLBOX_BUILD_TESTS": "On",
        "NUMERICAL_TOOLBOX_BUILD_SIMULATOR": "Off",
        "QEMU_MACHINE": "mps2-an386",
        "CMAKE_CXX_FLAGS": "-DGTEST_HAS_STREAM_REDIRECTION=0 -DGTEST_HAS_POSIX_RE=0 -D_POSIX_C_SOURCE=200112L"
      }
    },
    {
      "name": "qemu-cortex-m7",
      "displayName": "QEMU Cortex-M7 Tests",
      "inherits": "defaults",
      "toolchainFile": "${sourceDir}/build/${presetName}/_deps/emil-src/cmake/toolchain-arm-gcc-m7-fpv5-d16.cmake",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "RelWithDebInfo",
        "NUMERICAL_TOOLBOX_BUILD_TESTS": "On",
        "NUMERICAL_TOOLBOX_BUILD_SIMULATOR": "Off",
        "QEMU_MACHINE": "mps2-an500",
        "CMAKE_CXX_FLAGS": "-DGTEST_HAS_STREAM_REDIRECTION=0 -DGTEST_HAS_POSIX_RE=0 -D_POSIX_C_SOURCE=200112L"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host-RelWithDebInfo",
      "configuration": "RelWithDebInfo",
      "configurePreset": "host"
    },
    {
      "name": "host-Debug",
      "configuration": "Debug",
      "configurePreset": "host"
    },
    {
      "name": "host-Debug-WithPackage",
      "configuration": "Debug",
      "configurePreset": "host",
      "targets": [
        "all",
        "package"
      ]
    },
    {
      "name": "host-single-Debug",
      "configuration": "Debug",
      "configurePreset": "host-single-Debug"
    },
    {
      "name": "coverage",
      "configuration": "Debug",
      "configurePreset": "coverage"
    },
    {
      "name": "integration-Debug",
      "configuration": "Debug",
      "configurePreset": "integration"
    },
    {
      "name": "qemu-cortex-m4-RelWithDebInfo",
      "configuration": "RelWithDebInfo",
      "configurePreset": "qemu-cortex-m4",
      "targets": [
        "numerical.analysis_test",
        "numerical.analysis.windowing_test",
        "numerical.control_analysis_test",
        "numerical.controllers_test",
        "numerical.estimators.offline_test",
        "numerical.estimators.online_test",
        "numerical.filters.active_test",
        "numerical.filters.passive_test",
        "numerical.math_test",
        "numerical.nonlinear_control_test",
        "numerical.optimization_test",
        "numerical.regularization_test",
        "numerical.robust_control_test",
        "numerical.solvers_test"
      ]
    },
    {
      "name": "qemu-cortex-m7-RelWithDebInfo",
      "configuration": "RelWithDebInfo",
      "configurePreset": "qemu-cortex-m7",
      "targets": [
        "numerical.analysis_test",
        "numerical.analysis.windowing_test",
        "numerical.control_analysis_test",
        "numerical.controllers_test",
        "numerical.estimators.offline_test",
        "numerical.estimators.online_test",
        "numerical.filters.active_test",
        "numerical.filters.passive_test",
        "numerical.math_test",
        "numerical.nonlinear_control_test",
        "numerical.optimization_test",
        "numerical.regularization_test",
        "numerical.robust_control_test",
        "numerical.solvers_test"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "defaults",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true
      }
    },
    {
      "name": "host",
      "configurePreset": "host",
      "configuration": "Debug",
      "inherits": "defaults"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "configuration": "Debug",
      "inherits": "defaults"
    },
    {
      "name": "host-single-Debug",
      "configurePreset": "host-single-Debug",
      "configuration": "Debug",
      "inherits": "defaults"
    },
    {
      "name": "integration",
      "configurePreset": "integration",
      "configuration": "Debug",
      "inherits": "defaults"
    },
    {
      "name": "qemu-cortex-m4",
      "configurePreset": "qemu-cortex-m4",
      "configuration": "RelWithDebInfo",
      "inherits": "defaults"
    },
    {
      "name": "qemu-cortex-m7",
      "configurePreset": "qemu-cortex-m7",
      "configuration": "RelWithDebInfo",
      "inherits": "defaults"
    }
  ]
}
